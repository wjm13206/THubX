{
  "bundle": {
    "require_mode": "path"
  },
  "generator": {
    "name": "dense",
    "column_span": 9999999999
  },
  "rules": [
    "remove_comments",
    "remove_empty_do",
    "remove_spaces",
    "remove_types",
    "remove_unused_variable",
    {
      "rule": "rename_variables",
      "include_functions": true,
      "globals": ["$default", "$roblox"]
    }
  ]
}
